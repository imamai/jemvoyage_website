# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://sedsjjmjnikppfaecaya.supabase.co

# Publishable anon key — safe in the browser, constrained by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses ALL row level security on every app in this project.
# Never import this into a Client Component or expose it via NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Jemvoyage
NEXT_PUBLIC_DEFAULT_CURRENCY=KES

# ── M-Pesa / Safaricom Daraja (Phase 4) ───────────────────────────────────────
# Server-only. Never referenced from client code; all STK Push and callback
# handling lives in API routes.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ── Maps (Phase 2) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Notifications (Phase 4) ───────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
